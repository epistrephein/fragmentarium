---
import '../styles/global.css';
import { sitePath } from '../lib/fragments';

interface Props {
  title: string;
  description?: string;
  /** The homepage keeps a mute top edge: the title lives in the hero instead. */
  showMasthead?: boolean;
}

const {
  title,
  description = 'The Silent Campaign, an Italian novel published in fragments.',
  showMasthead = true,
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="The Silent Campaign"
      href={new URL(sitePath('rss.xml'), Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="The Silent Campaign" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(sitePath('og-placeholder.png'), Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(sitePath('og-placeholder.png'), Astro.site)} />
  </head>

  <body>
    {
      showMasthead && (
        <header class="masthead">
          <div class="container masthead-inner">
            <a class="masthead-link" href={sitePath()}>The Silent Campaign</a>
          </div>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <nav class="footer-nav label" aria-label="Secondary navigation">
          <a href={sitePath('read-all/')}>Read all</a>
          <a href={sitePath('archive/')}>Archive</a>
          <a href={sitePath('about/')}>About</a>
          <a href={sitePath('rss.xml')}>RSS</a>
        </nav>
        <p class="footer-note label">&copy; {currentYear} Tommaso Barbato</p>
      </div>
    </footer>

    <script>
      const readFragmentsStorageKey = 'fragmentarium.read-fragments';

      function getReadFragmentOrders() {
        try {
          const saved = JSON.parse(localStorage.getItem(readFragmentsStorageKey) ?? '[]');

          if (!Array.isArray(saved)) return new Set();

          return new Set(
            saved
              .filter((order) => Number.isInteger(order) && order > 0)
              .map((order) => String(order)),
          );
        } catch {
          return new Set();
        }
      }

      const readFragmentOrders = getReadFragmentOrders();

      function saveReadFragmentOrders() {
        try {
          localStorage.setItem(
            readFragmentsStorageKey,
            JSON.stringify([...readFragmentOrders].map(Number)),
          );
        } catch {
          // Reading should remain uninterrupted if browser storage is unavailable.
        }
      }

      function applyReadStates() {
        document.querySelectorAll<HTMLElement>('[data-fragment-order]').forEach((element) => {
          const isRead = readFragmentOrders.has(element.dataset.fragmentOrder ?? '');
          element.classList.toggle('is-read', isRead);

          const readToggle = element.querySelector<HTMLButtonElement>('[data-read-toggle]');
          if (readToggle) {
            readToggle.textContent = isRead ? '✓ READ' : 'UNREAD';
            readToggle.setAttribute('aria-pressed', String(isRead));
          }
        });
      }

      function refreshReadStates() {
        readFragmentOrders.clear();
        getReadFragmentOrders().forEach((order) => readFragmentOrders.add(order));
        applyReadStates();
      }

      applyReadStates();

      window.addEventListener('pageshow', refreshReadStates);
      window.addEventListener('storage', (event) => {
        if (event.key === readFragmentsStorageKey || event.key === null) {
          refreshReadStates();
        }
      });

      document.addEventListener('fragmentarium:fragment-read', (event) => {
        const order = (event as CustomEvent<{ order: number }>).detail.order;
        readFragmentOrders.add(String(order));
        saveReadFragmentOrders();
        applyReadStates();
      });

      document.addEventListener('click', (event) => {
        const readToggle = (event.target as Element).closest<HTMLButtonElement>('[data-read-toggle]');
        if (!readToggle) return;

        const fragment = readToggle.closest<HTMLElement>('[data-fragment-order]');
        const order = fragment?.dataset.fragmentOrder;
        if (!order) return;

        fragment.dataset.readStatusToggled = 'true';

        if (readFragmentOrders.has(order)) {
          readFragmentOrders.delete(order);
        } else {
          readFragmentOrders.add(order);
        }

        saveReadFragmentOrders();
        applyReadStates();
      });
    </script>
  </body>
</html>
