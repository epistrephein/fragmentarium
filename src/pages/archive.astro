---
import Base from '../layouts/Base.astro';
import Register from '../components/Register.astro';
import { getRecentFragments } from '../lib/fragments';

const fragments = await getRecentFragments();
---

<Base
  title="Archivio — La campagna silenziosa"
  description="Tutti i frammenti pubblicati de La campagna silenziosa, dal più recente."
>
  <section class="container page-head">
    <p class="page-eyebrow label">Archivio</p>
    <h1 class="page-title">Tutti i frammenti</h1>
  </section>

  <section class="container section">
    <Register fragments={fragments} />
  </section>
</Base>
