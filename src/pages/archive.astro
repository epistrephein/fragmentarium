---
import Base from '../layouts/Base.astro';
import Register from '../components/Register.astro';
import { getFragmentsDescending } from '../lib/fragments';

const fragments = await getFragmentsDescending();
---

<Base
  title="Archive — The Silent Campaign"
  description="All published fragments from The Silent Campaign, in reverse order."
>
  <section class="container page-head">
    <p class="page-eyebrow label">Archive</p>
    <h1 class="page-title">All fragments</h1>
  </section>

  <section class="container section">
    <Register fragments={fragments} />
  </section>
</Base>
