---
import Base from '../layouts/Base.astro';
import Register from '../components/Register.astro';
import { formatDate, getFragmentsDescending } from '../lib/fragments';

const fragments = await getFragmentsDescending();
const latest = fragments.slice(0, 15);
const lastUpdate = fragments[0]?.data.published;
---

<Base
  title="The Silent Campaign — a novel in fragments"
  description="An Italian novel published in fragments: a province emptying out, an election campaign no one names."
  showMasthead={false}
>
  <section class="container hero">
    <h1 class="hero-title">The Silent<br />Campaign</h1>
    <p class="work-author">by Tommaso Barbato</p>

    <p class="hero-status label">
      <span>A novel in fragments</span>
      <span>{fragments.length} {fragments.length === 1 ? 'fragment' : 'fragments'}</span>
      {lastUpdate && <span>Latest: {formatDate(lastUpdate)}</span>}
    </p>

    <div class="hero-intro">
      <p>
        A novel released one piece at a time. Summer in a province emptying out:
        faded posters on boundary walls, a committee meeting in the room above the
        pharmacy, a registry clerk keeping count of those who leave and do not return.
      </p>
      <p>
        No one raises their voice. That is why everything can be heard. The fragments
        have no titles: they are counted.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2 class="section-title label">Latest fragments</h2>
      <a class="label" href="/archive/">Archive &#8594;</a>
    </div>
    <Register fragments={latest} />
  </section>
</Base>
